# ---- AI Business Empire control room ----

# Leave blank (or set USE_MOCK=true) to run the deterministic mock decision
# engine with zero token cost. Set a real key to use claude-sonnet-4-6.
ANTHROPIC_API_KEY=

# Force the mock engine even if a key is present (great for demos / CI).
USE_MOCK=true

# Model used for live agent reasoning when a key is present.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Simulation pacing. One "tick" ~= one simulated business day.
BASE_TICK_SECONDS=3.0
# CEO reviews every N ticks.
CEO_REVIEW_EVERY=6

# Shared starting treasury the CEO allocates across storefronts (USD).
STARTING_TREASURY=2000

# SQLite file (relative to backend/).
DB_PATH=empire.db
